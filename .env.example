# Optional. Without a key the app runs fully in offline (non-AI) mode.
# Keep this server-side only: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-opus-5-5).
AI_MODEL=

# Strongly recommended if you deploy publicly with an API key:
# the AI endpoint then requires this code (enter it once in Settings).
APP_ACCESS_CODE=
